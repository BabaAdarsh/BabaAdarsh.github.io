rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid
        && exists(/databases/$(database)/documents/hqOwners/$(uid));
    }
    // Owner allowlist must be created in Firebase Console by the project admin.
    // A signed-in user can neither add their own allowlist entry nor elevate roles.
    match /hqOwners/{uid} {
      allow read: if owns(uid);
      allow write: if false;
    }
    match /users/{uid}/{collection}/{item} {
      allow read: if owns(uid) && collection in [
        'missions','jobs','updates','devices',
        'syncMeta','syncIssues','briefings','notificationLog'];
      allow create, update, delete: if owns(uid)
        && collection in ['missions','jobs','updates','devices'];
    }
    match /users/{uid}/sentAlerts/{alertId} { allow read,write: if false; }
    match /{document=**} { allow read,write: if false; }
  }
}